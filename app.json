{
  "expo": {
    "name": "VendStats",
    "slug": "vendstats",
    "scheme": "vendstats",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vendstats.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "16",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#E8F1F8"
      },
      "package": "com.codewerx.vendstats",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#E8F1F8"
        }
      ],
      "expo-localization",
      [
        "./plugins/withAdmob",
        {
          "androidAppId": "ca-app-pub-8863066373093222~4764574849"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-asset",
      "@react-native-firebase/app",
      [
        "@react-native-firebase/analytics",
        {
          "ios": {
            "googleAppMeasurementOnDeviceConversion": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aa040f51-49f9-4370-a6ec-ec37b14139d8"
      }
    }
  }
}
