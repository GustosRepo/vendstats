  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.17",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "3.3.2",
    "ts-jest": "^29.4.6",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "react-native-google-mobile-ads"
        ]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-chart-kit",
          "uuid"
